# =============================================================================
# Oshimai — Environment Configuration Template
# =============================================================================
# Salin file ini: cp .env.example .env
# Lalu isi dengan nilai kamu sendiri.
# File .env TIDAK boleh di-commit (sudah di-exclude via .gitignore).
# =============================================================================

# Bynara AI (https://bynara.id) — untuk fitur natural-language scenario generation
BYNARA_API_KEY=your-bynara-api-key-here
BYNARA_MODEL=mistral-medium-3-5

# Server (opsional — nilai default sudah cukup untuk development lokal)
# SERVER_ADDR=:8080
# MAX_RUNS=2
# CHAOS_DRIVER=mock
# DB_PATH=oshimai.db   # default: oshimai.db di sebelah binary server. ":memory:" = tidak persisten.
